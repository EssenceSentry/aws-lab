  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare-bank.mjs && vite --host 127.0.0.1",
    "build": "node scripts/prepare-bank.mjs && tsc --noEmit && vite build && node scripts/build-sw.mjs",
    "preview": "vite preview --host 127.0.0.1",
