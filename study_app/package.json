  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.13.0",
    "entities": "^8.1.0",
    "marked": "^18.0.13",
    "playwright": "^1.63.0",
    "sanitize-html": "^2.17.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
